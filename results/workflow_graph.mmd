---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	analyze(analyze)
	retrieve(retrieve)
	grade(grade)
	rewrite(rewrite)
	generate(generate)
	verify(verify)
	finalize(finalize)
	not_found(not_found)
	summarize(summarize)
	chitchat(chitchat)
	__end__([<p>__end__</p>]):::last
	__start__ --> analyze;
	analyze -.-> chitchat;
	analyze -. &nbsp;document&nbsp; .-> retrieve;
	analyze -. &nbsp;summary&nbsp; .-> summarize;
	generate -.-> finalize;
	generate -.-> rewrite;
	generate -.-> verify;
	grade -.-> generate;
	grade -.-> not_found;
	grade -.-> rewrite;
	retrieve --> grade;
	rewrite --> retrieve;
	verify -.-> finalize;
	verify -. &nbsp;regenerate&nbsp; .-> generate;
	verify -. &nbsp;abstain&nbsp; .-> not_found;
	verify -.-> rewrite;
	chitchat --> __end__;
	finalize --> __end__;
	not_found --> __end__;
	summarize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
